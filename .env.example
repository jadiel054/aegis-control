# Neon (pooled)  required
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Optional: gate the dashboard. If empty, login accepts any password / open access.
AEGIS_ADMIN_PASSWORD=

# Required for API authentication on write operations (missions, agents, commands, messages)
# Generate a strong random key (32+ characters)
AEGIS_API_KEY=your-strong-api-key-here-minimum-32-characters

# Required for Telegram approval validation in production
# Comma-separated list of allowed Telegram chat IDs (e.g., "6151151338,123456789")
TELEGRAM_ALLOWED_CHAT_IDS=your-telegram-chat-id,another-allowed-chat-id

# Optional: Secret token for Telegram webhook setup endpoint
TELEGRAM_SETUP_SECRET=optional-setup-secret-token

# Optional: Secret token for Telegram webhook validation
TELEGRAM_WEBHOOK_SECRET=optional-webhook-secret-token

# Public URL of this app (for agents and Telegram webhook)
# NEXT_PUBLIC_AEGIS_URL=https://aegis-control.vercel.app
