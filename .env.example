# =============================================================================
# AEGIS CONTROL - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Get from: https://console.neon.tech/app/projects
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.xxx.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Admin password for dashboard login
AEGIS_ADMIN_PASSWORD=your-strong-admin-password-minimum-16-characters

# API Key for all write operations (agents, SDK, external systems)
AEGIS_API_KEY=your-strong-api-key-minimum-32-characters

# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of allowed chat IDs (use /id command to get your chat ID)
TELEGRAM_ALLOWED_CHAT_IDS=6151151338,123456789

# Webhook secret for verification
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-key

# Setup secret for initial configuration
TELEGRAM_SETUP_SECRET=your-setup-secret-key

# -----------------------------------------------------------------------------
# AGENT INTEGRATIONS (for REAL execution mode)
# -----------------------------------------------------------------------------
# URLs where agents are deployed
MORPHEUS_API_URL=https://morpheus-app-5bmx.onrender.com
PLUTAO_API_URL=https://plutao-os.vercel.app
ZARITH_API_URL=https://zarith-api-server.onrender.com

# API keys for agent-to-agent communication (if required)
MORPHEUS_API_KEY=optional-morpheus-api-key
PLUTAO_API_KEY=optional-plutao-api-key
ZARITH_API_KEY=optional-zarith-api-key

# -----------------------------------------------------------------------------
# LLM PROVIDERS (for Jarvis Comando brain)
# -----------------------------------------------------------------------------
# Groq API key (primary)
GROQ_API_KEY=your-groq-api-key

# OpenRouter API key (fallback)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Custom model for Jarvis
JARVIS_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# AEGIS PUBLIC URL (for agent callbacks)
# -----------------------------------------------------------------------------
AEGIS_PUBLIC_URL=https://aegis-control.vercel.app

# -----------------------------------------------------------------------------
# DEPLOYMENT
# -----------------------------------------------------------------------------
# Vercel / Render environment
NODE_ENV=production

# Port for local development
PORT=3000

# =============================================================================
# NOTES:
# =============================================================================
# 1. All write operations (POST, PATCH) require AEGIS_API_KEY header
# 2. Telegram chat IDs can be obtained with /id command
# 3. For REAL execution mode, all three agent URLs must be configured
# 4. Agents must have AEGIS_BASE_URL and AEGIS_AGENT_NAME env vars
# 5. Database is Neon PostgreSQL (Supabase fully removed)
# =============================================================================
